# =============================================================================
# API keys — fill in only the providers you actually use.
# =============================================================================

# Anthropic Claude
ANTHROPIC_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE_URL=https://api.deepseek.com/v1

# Google Gemini
GEMINI_API_KEY=

# Moonshot / Kimi
KIMI_API_KEY=
KIMI_API_BASE_URL=https://api.moonshot.cn/v1

# Alibaba DashScope (Qwen API)
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# -----------------------------------------------------------------------------
# Local / self-hosted OpenAI-compatible endpoint
#   (vLLM OpenAI server, sglang, llama.cpp server, LM Studio, ...).
# Used by provider "openai_compatible".
# -----------------------------------------------------------------------------
OPENAI_COMPAT_BASE_URL=http://127.0.0.1:30001/v1
OPENAI_COMPAT_API_KEY=EMPTY
OPENAI_COMPAT_MODEL=default
